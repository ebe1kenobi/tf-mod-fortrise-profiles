      <Win>Content/Atlas/sprites/portraits/portraits_win1.png</Win>
      <Lose>Content/Atlas/sprites/portraits/portraits_lose1.png</Lose>
    </Portraits>
    <Statue>
      <Image>Content/Atlas/sprites/statues/player_statues_blue.png</Image>
      <Glow>Content/Atlas/sprites/statues/player_statues_blueGlow.png</Glow>
    </Statue>
    <Gems>
      <Menu>@Gem1</Menu>
      <Gameplay>@Gem1</Gameplay>
