    <SFX>1</SFX>
    <Corpse>@Blue</Corpse>
    <VictoryMusic>Blue</VictoryMusic>
    <Gender>Female</Gender>
    <Sprites>
      <Body>@PlayerBody1</Body>
      <HeadNormal>@PlayerHeadNormal1</HeadNormal>
      <HeadNoHat>@PlayerHeadNoHat1</HeadNoHat>
      <HeadCrown>@PlayerHeadCrown1</HeadCrown>
      <Bow>@PlayerBow1</Bow>
    </Sprites>
    <Hat>
      <Normal>Content/Atlas/sprites/hat/player_hat_blue_normal.png</Normal>
      <Blue>Content/Atlas/sprites/hat/player_hat_blue_blue.png</Blue>
      <Red>Content/Atlas/sprites/hat/player_hat_blue_red.png</Red>
    </Hat>
    <Portraits>
      <NotJoined>Content/Atlas/sprites/portraits/portraits_notJoined1.png</NotJoined>
