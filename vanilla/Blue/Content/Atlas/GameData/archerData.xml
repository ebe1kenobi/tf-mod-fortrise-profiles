      <NotJoined>Content/Atlas/sprites/portraits/portraits_notJoinedAlt1.png</NotJoined>
      <Joined>Content/Atlas/sprites/portraits/portraits_joinedAlt1.png</Joined>
      <Win>Content/Atlas/sprites/portraits/portraits_winAlt1.png</Win>
      <Lose>Content/Atlas/sprites/portraits/portraits_loseAlt1.png</Lose>
    </Portraits>
    <Statue>
      <Image>Content/Atlas/sprites/statues/player_statues_blueAlt.png</Image>
      <Glow>Content/Atlas/sprites/statues/player_statues_blueAltGlow.png</Glow>
