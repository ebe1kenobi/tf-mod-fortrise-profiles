    <Sprites>
      <Body>@PlayerBody6</Body>
      <HeadNormal>@PlayerHeadNormal6</HeadNormal>
      <HeadNoHat>@PlayerHeadNoHat6</HeadNoHat>
      <HeadCrown>@PlayerHeadCrown6</HeadCrown>
      <Bow>@PlayerBow6</Bow>
